 // Whether raysAvx may run (the processor and the system: SDL's check). Made before main, read by the bake's threads.
 const bool cpuHasAvx = SDL_HasAVX() == SDL_TRUE;
+#else
+// ARM correctness path: identical candidate ray test without x86 intrinsics.
+const bool cpuHasAvx = false;
+void raysSse(const RayInput& in)
+{
+    const PoseScratch& s = *in.s;
+    for(int r = 0; r < RAYS; ++r)
+    {
+        float best = in.reach;
+        for(int c = 0; c < in.nc; ++c)
+        {
+            const float px = in.dy[r]*s.e2z[c]-s.e2y[c]*in.dz[r];
+            const float py = in.dz[r]*s.e2x[c]-s.e2z[c]*in.dx[r];
+            const float pz = in.dx[r]*s.e2y[c]-s.e2x[c]*in.dy[r];
+            const float det = (s.e1x[c]*px+s.e1y[c]*py)+s.e1z[c]*pz;
+            if(fabsf(det) < 1e-9f) continue;
+            const float inv = 1.f/det;
+            const float u = ((s.sx[c]*px+s.sy[c]*py)+s.sz[c]*pz)*inv;
+            if(u < 0.f || u > 1.f) continue;
+            const float v = ((in.dx[r]*s.qx[c]+in.dy[r]*s.qy[c])+in.dz[r]*s.qz[c])*inv;
+            if(v < 0.f || u+v > 1.f) continue;
+            const float distance = s.e2q[c]*inv;
+            if(distance > in.tmin && distance < best) best = distance;
+        }
+        in.best[r] = best;
+    }
+}
+void raysAvx(const RayInput& in) { raysSse(in); }
+#endif
